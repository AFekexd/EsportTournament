# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/esport_tournament

# Keycloak
KEYCLOAK_URL=https://keycloak.pollak.info
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=esport

# Discord Bot
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_here
DISCORD_CATEGORY_ID=your_category_id_here
 
# Kiosk & Security
KIOSK_ADMIN_PASSWORD=change_this_to_a_secure_admin_password
UNSUBSCRIBE_SECRET=change_this_to_a_secure_random_hmac_secret
RAWG_API_KEY=your_rawg_api_key_here
STEAM_API_KEY=your_steam_api_key_here
